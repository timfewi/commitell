{
  "name": "commitell",
  "image": "mcr.microsoft.com/devcontainers/go:1-1.26-bookworm",
  "remoteUser": "vscode",
  "postCreateCommand": "go test ./...",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.Go",
        "jnoortheen.nix-ide"
      ],
      "settings": {
        "go.useLanguageServer": true,
        "gopls": {
          "ui.semanticTokens": true
        }
      }
    }
  }
}
